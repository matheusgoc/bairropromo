{
  "name": "bp-app",
  "main": "expo-router/entry",
  "version": "0.0.1",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint --fix",
    "format": "prettier . --write",
    "test": "jest --watchAll",
    "prebuild": "expo prebuild",
    "build:list": "npx eas-cli build:list",
    "build:run": "npx eas-cli build:run",
    "update:dev": "npx eas-cli update --channel development --message 'Development Update'",
    "update:staging": "npx eas-cli update --channel staging --message 'Staging Update'",
    "update:preview": "npx eas-cli update --channel preview --message 'Preview Update'",
    "update:prod": "npx eas-cli update --channel production --message 'Production Update'",
    "build:staging": "npx eas-cli build --profile staging",
    "build:preview": "npx eas-cli build --profile preview",
    "build:prod": "npx eas-cli build --profile production",
    "build:dev": "npx eas-cli build --profile development",
    "config": "expo config --type public",
    "prepare": "husky"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@pchmn/expo-material3-theme": "^1.3.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.96.2",
    "burnt": "^0.13.0",
    "dayjs": "^1.11.19",
    "expo": "~54.0.27",
    "expo-constants": "~18.0.11",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.10",
    "expo-router": "~6.0.17",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.14",
    "expo-web-browser": "~15.0.10",
    "moti": "^0.30.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.73.1",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "^1.21.7",
    "react-native-mask-input": "^1.2.3",
    "react-native-paper": "^5.14.5",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^5.96.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.14",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript": "~5.9.2"
  },
  "private": true
}
